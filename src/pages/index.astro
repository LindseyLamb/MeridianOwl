---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiceCard from "../components/ServiceCard.astro";
---

<BaseLayout
  title="Meridian Owl Advisory | Governance, Risk and Cybersecurity"
  description="Meridian Owl Advisory provides practical governance, cybersecurity, privacy, compliance and responsible technology guidance."
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-content">
        <p class="eyebrow">
          Governance · Risk · Cybersecurity
        </p>

        <h1>
          Navigate complexity.
          <span>See farther.</span>
        </h1>

        <p class="hero-introduction">
          Meridian Owl Advisory helps organizations
          understand risk, strengthen governance and make
          confident decisions about complex systems.
        </p>

        <div class="hero-actions">
          <a class="button" href="/contact">
            Start a conversation
          </a>

          <a
            class="button button-secondary"
            href="/services"
          >
            Explore services
          </a>
        </div>
      </div>

      <div class="hero-art" aria-hidden="true">
        <div class="orbital-ring ring-one"></div>
        <div class="orbital-ring ring-two"></div>
        <div class="meridian-line"></div>

        <div class="owl-placeholder">
          <span>MO</span>
        </div>
      </div>
    </div>
  </section>

  <section class="services-section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Areas of practice</p>

          <h2>
            Practical guidance for complex risk
          </h2>
        </div>

        <p>
          Build programs that satisfy requirements,
          support the business and remain sustainable
          after the assessment is complete.
        </p>
      </div>

      <div class="services-grid">
        <ServiceCard
          title="Governance and GRC"
          description="Design governance structures, risk processes, policies and controls that connect regulatory requirements with organizational priorities."
        />

        <ServiceCard
          title="Cybersecurity Advisory"
          description="Translate technical exposure into clear priorities, practical roadmaps and decisions that leadership can confidently support."
        />

        <ServiceCard
          title="Privacy and AI Governance"
          description="Develop responsible approaches to data, privacy and emerging technology without losing sight of operational reality."
        />
      </div>
    </div>
  </section>

  <section class="perspective-section">
    <div class="container perspective-grid">
      <div class="perspective-mark" aria-hidden="true">
        <span>01</span>
      </div>

      <div class="perspective-content">
        <p class="eyebrow">The Meridian Owl approach</p>

        <h2>
          Good governance should create direction,
          not drag.
        </h2>

        <p class="large-copy">
          Compliance may establish the destination, but
          reaching it requires judgment, context and a
          route that fits the organization.
        </p>

        <p>
          Meridian Owl combines systems thinking,
          cybersecurity knowledge and practical risk
          management to help organizations see the whole
          landscape—not simply the next audit finding.
        </p>

        <a class="text-link" href="/about">
          Learn about Meridian Owl
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="principles-section">
    <div class="container">
      <p class="eyebrow">Guiding principles</p>

      <div class="principles-grid">
        <article>
          <span>01</span>
          <h3>See the system</h3>
          <p>
            Understand how people, technology, policy and
            incentives interact before recommending change.
          </p>
        </article>

        <article>
          <span>02</span>
          <h3>Clarify the risk</h3>
          <p>
            Replace vague warnings with information leaders
            can use to make defensible decisions.
          </p>
        </article>

        <article>
          <span>03</span>
          <h3>Chart a practical route</h3>
          <p>
            Turn complex requirements into achievable,
            prioritized and sustainable action.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container cta-inner">
      <div>
        <p class="eyebrow">Begin the conversation</p>

        <h2>
          Need a clearer view of what comes next?
        </h2>
      </div>

      <div class="cta-copy">
        <p>
          Let’s discuss the challenge, the surrounding
          constraints and the most useful next step.
        </p>

        <a class="button" href="/contact">
          Contact Meridian Owl
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;

    min-height: 46rem;
    padding-block: var(--space-9);

    background:
      radial-gradient(
        circle at 82% 38%,
        rgb(182 140 63 / 18%),
        transparent 27rem
      ),
      linear-gradient(
        135deg,
        var(--color-cream-50),
        var(--color-cream-100)
      );
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(19rem, 0.85fr);
    gap: var(--space-8);
    align-items: center;
  }

  .hero-content {
    position: relative;
    z-index: 2;
  }

  h1 {
    max-width: 52rem;
    margin-bottom: var(--space-5);
  }

  h1 span {
    display: block;
    color: var(--color-gold-600);
  }

  .hero-introduction {
    max-width: 43rem;

    font-size: clamp(1.15rem, 2vw, 1.45rem);
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);

    margin-top: var(--space-6);
  }

  .hero-art {
    position: relative;

    display: grid;
    place-items: center;

    min-height: 31rem;
  }

  .owl-placeholder {
    position: relative;
    z-index: 2;

    display: grid;
    place-items: center;

    width: min(18rem, 70vw);
    aspect-ratio: 1;

    border: 1px solid var(--color-gold-600);
    border-radius: 50%;

    background: var(--color-navy-950);
    box-shadow: var(--shadow-soft);
  }

  .owl-placeholder span {
    color: var(--color-gold-300);

    font-family: var(--font-heading);
    font-size: 4rem;
    letter-spacing: 0.08em;
  }

  .orbital-ring {
    position: absolute;

    width: 26rem;
    aspect-ratio: 1;

    border: 1px solid rgb(156 118 47 / 28%);
    border-radius: 50%;
  }

  .ring-one {
    transform: rotate(22deg) scaleY(0.52);
  }

  .ring-two {
    transform: rotate(-28deg) scaleY(0.68);
  }

  .meridian-line {
    position: absolute;

    width: 1px;
    height: 29rem;

    background: linear-gradient(
      transparent,
      var(--color-gold-600),
      transparent
    );
  }

  .services-section,
  .principles-section {
    padding-block: var(--space-9);
  }

  .services-section {
    background: var(--color-white);
  }

  .section-heading {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: var(--space-8);
    align-items: end;
  }

  .section-heading h2 {
    max-width: 47rem;
    margin-bottom: 0;
  }

  .section-heading > p {
    max-width: 32rem;
    margin-bottom: var(--space-2);

    font-size: 1.08rem;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);

    margin-top: var(--space-8);
  }

  .perspective-section {
    padding-block: var(--space-9);

    background: var(--color-navy-950);
    color: var(--color-white);
  }

  .perspective-grid {
    display: grid;
    grid-template-columns: 0.35fr 1.65fr;
    gap: var(--space-8);
  }

  .perspective-mark span {
    display: inline-block;

    color: var(--color-gold-300);

    font-family: var(--font-heading);
    font-size: clamp(5rem, 12vw, 10rem);
    line-height: 0.9;
  }

  .perspective-content {
    max-width: 52rem;
  }

  .perspective-content h2 {
    color: var(--color-white);
  }

  .perspective-content p {
    color: rgb(255 255 255 / 72%);
  }

  .perspective-content .large-copy {
    color: var(--color-white);
    font-size: clamp(1.3rem, 2.5vw, 1.75rem);
  }

  .text-link {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;

    margin-top: var(--space-4);

    color: var(--color-gold-300);

    font-weight: 750;
    text-decoration: none;
  }

  .text-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.35rem;
  }

  .principles-section {
    background: var(--color-cream-50);
  }

  .principles-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-7);

    margin-top: var(--space-7);
  }

  .principles-grid article {
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-gold-600);
  }

  .principles-grid article > span {
    color: var(--color-gold-600);

    font-family: var(--font-heading);
    font-size: 1.35rem;
  }

  .principles-grid h3 {
    margin-top: var(--space-4);
    margin-bottom: var(--space-3);
  }

  .cta-section {
    padding-block: var(--space-8);

    background: var(--color-gold-300);
  }

  .cta-inner {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: var(--space-8);
    align-items: center;
  }

  .cta-inner h2 {
    max-width: 48rem;
    margin-bottom: 0;
  }

  .cta-inner .eyebrow {
    color: var(--color-navy-950);
  }

  .cta-copy {
    max-width: 30rem;
  }

  .cta-copy p {
    color: var(--color-navy-950);
    font-size: 1.1rem;
  }

  @media (max-width: 54rem) {
    .hero-grid,
    .section-heading,
    .perspective-grid,
    .cta-inner {
      grid-template-columns: 1fr;
    }

    .services-grid,
    .principles-grid {
      grid-template-columns: 1fr;
    }

    .hero-art {
      min-height: 24rem;
    }

    .perspective-mark {
      display: none;
    }
  }

  @media (max-width: 34rem) {
    .hero {
      min-height: auto;
      padding-block: var(--space-8);
    }

    .hero-art {
      min-height: 20rem;
    }

    .orbital-ring {
      width: 20rem;
    }
  }
</style>