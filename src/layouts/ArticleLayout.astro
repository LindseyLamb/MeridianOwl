---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  publishedDate: Date;
  updatedDate?: Date;
  author: string;
  category: string;
  tags?: string[];
}

const {
  title,
  description,
  publishedDate,
  updatedDate,
  author,
  category,
  tags = [],
} = Astro.props;

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en-US", {
    month: "long",
    day: "numeric",
    year: "numeric",
  }).format(date);
---

<BaseLayout
  title={`${title} | The Observatory`}
  description={description}
>
  <article>
    <header class="article-header">
      <div class="container article-header-inner">
        <a class="back-link" href="/observatory">
          <span aria-hidden="true">←</span>
          The Observatory
        </a>

        <p class="eyebrow">{category}</p>

        <h1>{title}</h1>

        <p class="description">{description}</p>

        <div class="article-meta">
          <span>By {author}</span>

          <span aria-hidden="true">·</span>

          <time datetime={publishedDate.toISOString()}>
            {formatDate(publishedDate)}
          </time>

          {
            updatedDate && (
              <>
                <span aria-hidden="true">·</span>

                <span>
                  Updated{" "}
                  <time datetime={updatedDate.toISOString()}>
                    {formatDate(updatedDate)}
                  </time>
                </span>
              </>
            )
          }
        </div>
      </div>
    </header>

    <div class="container article-layout">
      <div class="article-decoration" aria-hidden="true">
        <span>MO</span>
      </div>

      <div class="article-body">
        <slot />

        {
          tags.length > 0 && (
            <footer class="article-tags">
              <h2>Topics</h2>

              <ul>
                {tags.map((tag) => <li>{tag}</li>)}
              </ul>
            </footer>
          )
        }
      </div>
    </div>
  </article>

  <section class="article-cta">
    <div class="container cta-grid">
      <div>
        <p class="eyebrow">Continue the conversation</p>

        <h2>
          Working through a related challenge?
        </h2>
      </div>

      <div>
        <p>
          Meridian Owl helps organizations turn complex
          governance and cybersecurity questions into
          practical next steps.
        </p>

        <a class="button" href="/contact">
          Start a conversation
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .article-header {
    padding-block: var(--space-8);

    background:
      radial-gradient(
        circle at 82% 35%,
        rgb(182 140 63 / 18%),
        transparent 27rem
      ),
      var(--color-cream-50);
  }

  .article-header-inner {
    max-width: 60rem;
  }

  .back-link {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;

    margin-bottom: var(--space-7);

    color: var(--color-slate-700);
    font-weight: 700;
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--color-gold-600);
  }

  h1 {
    max-width: 58rem;
    margin-bottom: var(--space-5);

    font-size: clamp(2.8rem, 7vw, 5.5rem);
  }

  .description {
    max-width: 48rem;

    font-size: clamp(1.15rem, 2.3vw, 1.4rem);
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);

    margin-top: var(--space-6);

    color: var(--color-slate-500);
    font-size: 0.9rem;
  }

  .article-layout {
    display: grid;
    grid-template-columns: 0.3fr minmax(0, 1fr);
    gap: var(--space-8);

    padding-block: var(--space-9);
  }

  .article-decoration {
    position: sticky;
    top: 8rem;

    display: grid;
    place-items: center;

    width: 7rem;
    height: 7rem;

    border: 1px solid var(--color-gold-600);
    border-radius: 50%;

    color: var(--color-gold-600);

    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 700;
  }

  .article-body {
    max-width: 48rem;

    color: var(--color-slate-700);
    font-size: 1.08rem;
  }

  .article-body :global(h2) {
    margin-top: var(--space-8);
    margin-bottom: var(--space-4);

    color: var(--color-navy-950);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
  }

  .article-body :global(h3) {
    margin-top: var(--space-6);
    margin-bottom: var(--space-3);

    color: var(--color-navy-950);
  }

  .article-body :global(p) {
    margin-bottom: var(--space-5);
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    display: grid;
    gap: var(--space-3);

    margin-block: var(--space-5);
    padding-left: 1.4rem;
  }

  .article-body :global(blockquote) {
    margin: var(--space-7) 0;
    padding: var(--space-5) var(--space-6);

    border-left: 4px solid var(--color-gold-600);

    background: var(--color-cream-100);
  }

  .article-body :global(blockquote p) {
    margin: 0;

    color: var(--color-navy-950);

    font-family: var(--font-heading);
    font-size: 1.45rem;
  }

  .article-tags {
    margin-top: var(--space-8);
    padding-top: var(--space-5);

    border-top: var(--border-subtle);
  }

  .article-tags h2 {
    margin: 0 0 var(--space-4);

    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .article-tags ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);

    margin: 0;
    padding: 0;

    list-style: none;
  }

  .article-tags li {
    padding: 0.4rem 0.75rem;

    border: var(--border-subtle);
    border-radius: 999px;

    color: var(--color-slate-700);
    font-size: 0.85rem;
  }

  .article-cta {
    padding-block: var(--space-8);
    background: var(--color-gold-300);
  }

  .cta-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: var(--space-8);
    align-items: center;
  }

  .cta-grid h2 {
    margin-bottom: 0;
  }

  .cta-grid p,
  .cta-grid .eyebrow {
    color: var(--color-navy-950);
  }

  .cta-grid .button {
    margin-top: var(--space-4);
  }

  @media (max-width: 54rem) {
    .article-layout,
    .cta-grid {
      grid-template-columns: 1fr;
    }

    .article-decoration {
      display: none;
    }
  }
</style>